{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "bd3ff682-5376-4bb1-a09b-ca6fd2c101c9","database_name": "5lz0e7e8utcs-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8dc01eeeb60a470387a7f44de41c9291" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
